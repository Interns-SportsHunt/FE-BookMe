# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_ANALYTICS=false

# Environment Information
VITE_APP_ENV=development
VITE_APP_VERSION=$npm_package_version

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
VITE_PAYMENT_GATEWAY_KEY=your-payment-gateway-key

# Deployment
VITE_PUBLIC_URL=/

# Performance
VITE_ENABLE_QUERY_CACHE=true
VITE_QUERY_CACHE_TIME=300000

# Copy this file to .env.local and update values for local development
# Copy this file to .env.production and update values for production 